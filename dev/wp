#!/bin/sh
here="$(dirname "$0")"
files="-f $here/docker-compose.yml"
if [ -f "$here/compose-extra.local" ]; then
  while IFS= read -r extra; do
    [ -n "$extra" ] && files="$files -f $here/$extra"
  done < "$here/compose-extra.local"
fi
exec docker compose $files run --rm -T cli "$@" 2>&1 | grep -v -E '^ Container .* (Running|Waiting|Healthy|Creating|Created|Starting|Started|Recreate|Recreated)'
